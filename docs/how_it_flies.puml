@startuml how_it_flies
' The race-day architecture (2026-09-22 build). Rendered for the site as an
' SVG in site/src/Architecture.jsx; keep the two in step.
skinparam backgroundColor white
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #555555
  RoundCorner 10
}

title The autonomy stack as it flew: race day, 2026-09-22

rectangle "BEFORE FLIGHT (laptop)" as before {
  rectangle "Published course map\n10 gates: position, crossing heading, opening height\none stacked gate (4.05 m top, 1.35 m low)" as map
  rectangle "Vehicle config\ncamera: tilt, FOV, focal length\nlimits: lean 8 deg, 1.5 m/s, climb rate; ladder k" as cfg
  rectangle "Planner\nfastest line inside the limits;\nrefuses lines that lose the camera or hit a frame" as planner
  rectangle "Plan (plan_STACK)\n505 samples: xyz, speed, heading\n23 crossings per 2 laps, 251 m\nframe: start line, +y down gate 0" as plan
  map --> planner
  cfg --> planner
  planner --> plan
}

rectangle "IN FLIGHT (Jetson Orin, 50 Hz, Python)" as loop {
  rectangle "Flight controller (Betaflight, MSP ~32 Hz)\nattitude, heading, accelerometer, barometer\nANGLE mode, MSP override on" as fc
  rectangle "Camera (IMX477 1080p60 -> 1280x720)\nHSV detector: ring bbox, opening centre,\noffsets, width range, clipped-ring rebuild,\ncommit rule" as cam
  rectangle "Estimator: vision-aided dead reckoning\naccel on attitude, gravity removed, integrated\npad-learned accel bias subtracted\ngate fix: map gate - range along bearing\n(strong across the bearing, weak along)\ncrossings counted 0.75 m past the plane\nheading: FC yaw at arm + drift rate" as est
  rectangle "Follower\nTRACKER: plan point ahead -> world accel -> ANGLE sticks;\n  last 6 m on the gate's centre line; nose on the next gate\nVERTICAL: gate elevation -> height reference (0.09 m/deg,\n  cap 0.20 m before g0, 0.35 m after), damped on a vz estimate\nCOMMIT: ring >= 85% x3 or both edges clip; within 6 m,\n  aligned, level -> no fixes, height frozen, hold throttle\nTHRUST MODEL: accel -> throttle us, hover measured (1205)" as fol
  rectangle "Stick commands, 50 Hz\nroll, pitch, yaw, throttle over MSP\ntrace + narration logged" as sticks
  fc --> est : attitude, accel, baro
  cam --> est : detections
  est --> fol : state
  plan --> fol
  fol --> sticks
  sticks --> fc : MSP override
}

rectangle "AROUND IT" as around {
  rectangle "Pilot (radio)\nthrottle low -> ARM -> MSP OVERRIDE -> ANGLE\nabort = MSP OVERRIDE off; any input ends the run" as pilot
  rectangle "Simulator (Elodin + Betaflight SITL, Docker)\nsame estimator and follower code\nsynthetic camera with dropout, noise, latency\nreferee: crossings; frame contact voids the run" as sim
  rectangle "Debrief tools\npull_flight: log + narration off the aircraft\ntriage checks; the site draws the same logs" as tools
}
pilot --> fc
sim .. fol

@enduml
